{
  "name": "{{project-name}}",
  "version": "0.1.0",
  "description": "{{PROJECT_NAME}} — HTML prototype with 11ty, Tailwind v4, and design-system-agnostic tokens",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "eleventy --serve --port=3000",
    "build": "eleventy",
    "build:standalone": "node scripts/inline-build.mjs",
    "build:spa": "node scripts/inline-build.mjs --spa",
    "build:inline": "npm run build:standalone && npm run build:spa",
    "build:all": "npm run build && npm run build:inline",
    "sync:agent-docs": "node scripts/sync-agent-docs.mjs",
    "clean": "rm -rf out out-*",
    "reset": "npm run clean && npm run build:all && npm run dev",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint src/assets/js/ scripts/ test/ eleventy.config.js",
    "lint:css": "stylelint 'src/assets/css/**/*.css'",
    "lint:fix": "eslint src/assets/js/ scripts/ test/ eleventy.config.js --fix",
    "test": "node --test test/**/*.test.cjs",
    "format": "prettier --write '*.{md,json,yml,yaml}' '.github/**/*.{yml,yaml}' 'docs/**/*.md' 'source-reference/**/*.md' 'src/**/*.{njk,css,js,json}' 'test/**/*.cjs'",
    "format:check": "prettier --check '*.{md,json,yml,yaml}' '.github/**/*.{yml,yaml}' 'docs/**/*.md' 'source-reference/**/*.md' 'src/**/*.{njk,css,js,json}' 'test/**/*.cjs'"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "markdown-it": "^14.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-jinja-template": "^2.1.0",
    "stylelint": "^17.5.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "overrides": {
    "brace-expansion@<1.1.13": "1.1.13",
    "brace-expansion@>=5.0.0 <5.0.6": "5.0.6",
    "fast-uri@<=3.1.1": "3.1.2",
    "liquidjs@<=10.25.7": "10.27.0",
    "postcss@<8.5.10": "8.5.15",
    "ws@>=8.0.0 <8.20.1": "8.21.0"
  }
}
